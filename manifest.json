{
  "manifest_version": 3,
  "name": "Sound Controller & EQ",
  "version": "0.1.0",
  "description": "Per-tab volume controll and equalizer. Remembers volume for each site.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icon/icon-16.png",
    "32": "assets/icon/icon-32.png",
    "48": "assets/icon/icon-128.png",
    "128": "assets/icon/icon-256.png"
  },
  "action": {
    "default_title": "Sound Controller & EQ",
    "default_icon": {
      "16": "assets/icon/icon-128.png",
      "32": "assets/icon/icon-256.png"
    },
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": ["activeTab", "offscreen", "tabCapture", "tabs", "storage"]
}