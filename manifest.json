{
  "manifest_version": 3,
  "name": "Sound Controller & EQ",
  "version": "0.1.2",
  "description": "Per-tab volume control and equalizer. Remembers volume for each site and restore it when you open popup once per tab.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "assets/icon/icon-16.png",
    "32": "assets/icon/icon-32.png",
    "128": "assets/icon/icon-256.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Alt+V"
      },
      "description": "Open Sound Controller & EQ"
    }
  },
  "action": {
    "default_title": "Sound Controller & EQ",
    "default_icon": {
      "16": "assets/icon/icon-128.png",
      "32": "assets/icon/icon-32.png"
    },
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "permissions": [
    "activeTab",
    "offscreen",
    "tabCapture",
    "tabs",
    "storage"
  ]
}